12s 동안 처리함

지금 막히는 핵심은 이것입니다.

<a href="./Action.jsx">이동</a>

이 방식으로는 안 됩니다. Action.jsx는 웹페이지가 아니라 App.jsx가 불러와서 사용하는 컴포넌트 파일입니다.

React Router는 아직 쓰지 말고, 버튼으로 화면을 전환하는 것부터 연습하는 게 좋습니다.

1. src/Action.jsx 새로 만들기

function Action({ onBack }) {
  return (
    <div className="page">
      <h1>Action 화면</h1>
      <p>App.jsx에서 Action.jsx로 넘어왔습니다.</p>

      <button onClick={onBack}>
        이전 화면
      </button>
    </div>
  );
}

export default Action;

2. src/App.jsx 전체 교체

import { useState } from "react";
import Action from "./Action.jsx";
import "./App.css";

function App() {
  const [currentPage, setCurrentPage] = useState("main");

  if (currentPage === "action") {
    return (
      <Action
        onBack={() => setCurrentPage("main")}
      />
    );
  }

  return (
    <div className="page">
      <h1>메인 화면</h1>
      <p>버튼을 누르면 Action 컴포넌트를 표시합니다.</p>

      <button onClick={() => setCurrentPage("action")}>
        Action 화면으로 이동
      </button>
    </div>
  );
}

export default App;

3. src/App.css 전체 교체


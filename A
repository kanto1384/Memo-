private void UpdateDynamicColumnsForSearch()
{
    // 대용량 안정화 모드:
    // JSON 기반 동적 컬럼 자동 생성은 OFF.
    // 500MB 로그에서 동적 컬럼은 메모리/CPU 부담이 큼.
    // 상세 값은 행 더블클릭 상세 로그에서 확인한다.

    foreach (var name in currentDynamicCols.ToList())
    {
        if (gridMerged.Columns.Contains(name))
            gridMerged.Columns.Remove(name);
    }

    currentDynamicCols.Clear();

    // 혹시 이전에 동적 컬럼 필터가 남아 있으면 제거
    foreach (var key in activeFilters.Keys.ToList())
    {
        if (key.StartsWith("colExtra_", StringComparison.OrdinalIgnoreCase))
            activeFilters.Remove(key);
    }

    gridMerged.Refresh();
}



private string MakeExtraColumnName(string key, int index)
{
    return $"colExtra_{key}_{index}";
}

private bool TryGetExtraValue(CombinedRow row, string colName, out string value)
{
    value = "";

    if (row == null)
        return false;

    if (row.ExtraValues == null)
        return false;

    if (string.IsNullOrWhiteSpace(colName))
        return false;

    return row.ExtraValues.TryGetValue(colName, out value);
}

private void ClearExtraValuesForAllRows()
{
    if (allMergedRows == null)
        return;

    foreach (var row in allMergedRows)
    {
        if (row != null)
            row.ExtraValues = null;
    }
}

private bool IsLotKey(string key)
{
    if (string.IsNullOrWhiteSpace(key))
        return false;

    string[] lotKeys =
    {
        "OUT_LOTID",
        "INPUT_LOTID",
        "INPUT_CSTID",
        "PROD_LOTID",
        "LOTID",
        "LOT_ID",
        "CSTID"
    };

    return lotKeys.Any(x =>
        string.Equals(x, key, StringComparison.OrdinalIgnoreCase));
}



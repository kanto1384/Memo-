7. UpdateDynamicColumnsForSearch() 전체 교체

교체 대상

private void UpdateDynamicColumnsForSearch()

전체 교체

private void UpdateDynamicColumnsForSearch()
{
    // 1) 기존 동적 컬럼 제거
    foreach (var name in currentDynamicCols.ToList())
    {
        if (gridMerged.Columns.Contains(name))
            gridMerged.Columns.Remove(name);
    }

    currentDynamicCols.Clear();

    if (txtSearchVar == null)
    {
        gridMerged.Refresh();
        return;
    }

    if (!chkCombine.Checked)
    {
        gridMerged.Refresh();
        return;
    }

    // 2) 검색창 또는 Var 컬럼 필터에서 BR 추출
    string[] bizTokens = GetCurrentBizTokensForDynamicColumns();

    if (bizTokens.Length == 0)
    {
        gridMerged.Refresh();
        return;
    }

    // 3) table.json BIZ_KEY_RULES 조회
    // 중요: extraKeyRules 아님. LoadRules()에서 bizKeyRules에 들어감.
    var targetKeys = new List<string>();

    foreach (string biz in bizTokens)
    {
        if (bizKeyRules != null &&
            bizKeyRules.TryGetValue(biz, out var keys) &&
            keys != null &&
            keys.Length > 0)
        {
            targetKeys.AddRange(keys);
        }
    }

    targetKeys = targetKeys
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList();

    if (targetKeys.Count == 0)
    {
        gridMerged.Refresh();
        return;
    }

    // 4) 현재 표시 Row 기준으로 컬럼 생성
    List<CombinedRow> targetRows =
        mergedRows != null && mergedRows.Count > 0
            ? mergedRows
            : searchMergedRows != null && searchMergedRows.Count > 0
                ? searchMergedRows
                : allMergedRows;

    if (targetRows == null || targetRows.Count == 0)
    {
        gridMerged.Refresh();
        return;
    }

    var maxIndexByKey = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

    foreach (string key in targetKeys)
    {
        int maxIdx = -1;

        foreach (CombinedRow row in targetRows)
        {
            if (row == null)
                continue;

            // 검색된 BR 또는 Var 필터 BR 기준만 확인
            if (!bizTokens.Any(b => string.Equals(b, row.Var, StringComparison.OrdinalIgnoreCase)))
                continue;

            int localMax = GetMaxDynamicIndexInRowRange(row, key);

            if (localMax > maxIdx)
                maxIdx = localMax;
        }

        if (maxIdx >= 0)
            maxIndexByKey[key] = maxIdx;
    }

    if (maxIndexByKey.Count == 0)
    {
        gridMerged.Refresh();
        return;
    }

    // 5) LOT 오른쪽에 동적 컬럼 삽입
    int lotIdx = gridMerged.Columns
        .Cast<DataGridViewColumn>()
        .FirstOrDefault(c =>
            c.DataPropertyName == "MLot" ||
            c.Name.Equals("colLot", StringComparison.OrdinalIgnoreCase))
        ?.Index ?? -1;

    int insertAt = lotIdx >= 0 ? lotIdx + 1 : gridMerged.Columns.Count;

    foreach (var kv in maxIndexByKey.OrderBy(x => x.Key, StringComparer.OrdinalIgnoreCase))
    {
        string key = kv.Key;
        int maxIdx = kv.Value;

        for (int i = 0; i <= maxIdx; i++)
        {
            string colName = $"colExtra_{key}_{i}";

            if (gridMerged.Columns.Contains(colName))
                continue;

            var col = new DataGridViewTextBoxColumn
            {
                Name = colName,
                HeaderText = $"{key}[{i}]",
                Width = 140,
                SortMode = DataGridViewColumnSortMode.Programmatic,
                Tag = (key, i)
            };

            gridMerged.Columns.Insert(insertAt++, col);
            currentDynamicCols.Add(colName);
        }
    }

    gridMerged.Refresh();
}



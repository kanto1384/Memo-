5. ApplyFilterAndBind 전체 교체

교체 대상

private void ApplyFilterAndBind()

전체 교체

private void ApplyFilterAndBind()
{
    // rows가 이미 비워진 상태라면 allMergedRows 기준으로만 다시 표시한다.
    // 경량 모드에서는 파일 로딩 후 rows를 유지하지 않는다.
    if ((rows == null || rows.Count == 0) && allMergedRows != null && allMergedRows.Count > 0)
    {
        string[] keys = GetSearchKeys();

        IEnumerable<CombinedRow> mergedSource = allMergedRows;

        if (keys.Length > 0)
        {
            mergedSource = mergedSource.Where(r =>
                keys.Any(k =>
                    (!string.IsNullOrWhiteSpace(r.Var) &&
                     r.Var.IndexOf(k, StringComparison.OrdinalIgnoreCase) >= 0)
                    ||
                    (!string.IsNullOrWhiteSpace(r.Status) &&
                     r.Status.IndexOf(k, StringComparison.OrdinalIgnoreCase) >= 0)
                    ||
                    (!string.IsNullOrWhiteSpace(r.MLot) &&
                     r.MLot.IndexOf(k, StringComparison.OrdinalIgnoreCase) >= 0)
                ));
        }

        mergedRows = mergedSource.ToList();
        searchMergedRows = mergedRows;

        bsMerged.DataSource = null;
        bsMerged.DataSource = mergedRows;

        gridMerged.DataSource = bsMerged;
        bs.DataSource = gridMerged.DataSource;

        UpdateDynamicColumnsForSearch();

        ToggleMode();
        UpdateStatusLabel();

        return;
    }

    // =========================
    // 1. 결합 보기 원본 생성
    // =========================
    var forMerged = rows.AsEnumerable();

    if (chkBROnly.Checked)
    {
        forMerged = forMerged.Where(r =>
            (r.Var ?? "").StartsWith("BR_", StringComparison.OrdinalIgnoreCase));
    }

    allMergedRows = BuildMergedQueue(
        forMerged
            .OrderBy(r => r.SourceFile, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.LineIndex)
    );

    string[] searchKeys = GetSearchKeys();

    IEnumerable<CombinedRow> source = allMergedRows;

    if (searchKeys.Length > 0)
    {
        source = source.Where(r =>
            searchKeys.Any(k =>
                (!string.IsNullOrWhiteSpace(r.Var) &&
                 r.Var.IndexOf(k, StringComparison.OrdinalIgnoreCase) >= 0)
                ||
                (!string.IsNullOrWhiteSpace(r.Status) &&
                 r.Status.IndexOf(k, StringComparison.OrdinalIgnoreCase) >= 0)
                ||
                (!string.IsNullOrWhiteSpace(r.MLot) &&
                 r.MLot.IndexOf(k, StringComparison.OrdinalIgnoreCase) >= 0)
            ));
    }

    mergedRows = source.ToList();
    searchMergedRows = mergedRows;

    bsMerged.DataSource = null;
    bsMerged.DataSource = mergedRows;

    gridMerged.DataSource = bsMerged;
    bs.DataSource = gridMerged.DataSource;

    // 라인 보기 비활성화에 가깝게 유지
    viewRows.Clear();
    bsLines.DataSource = null;

    UpdateDynamicColumnsForSearch();

    ToggleMode();
    UpdateStatusLabel();
}



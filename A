PickLotFromPairs(...) 바로 위나 아래.

새로 추가

private bool IsLotCandidateKey(string varName, string key)
{
    if (string.IsNullOrWhiteSpace(key))
        return false;

    var keys = new List<string>();

    if (!string.IsNullOrWhiteSpace(varName) &&
        lotKeyRules != null &&
        lotKeyRules.TryGetValue(varName, out var ruleKeys) &&
        ruleKeys != null)
    {
        keys.AddRange(ruleKeys);
    }

    if (defaultLotKeys != null)
        keys.AddRange(defaultLotKeys);

    keys.AddRange(new[]
    {
        "OUT_LOTID",
        "INPUT_LOTID",
        "INPUT_CSTID",
        "PROD_LOTID",
        "LOTID",
        "LOT_ID",
        "CSTID"
    });

    return keys
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Any(x => string.Equals(x, key, StringComparison.OrdinalIgnoreCase));
}



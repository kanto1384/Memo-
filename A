교체 대상

private string GetMergedCellSortKey(CombinedRow row, DataGridViewColumn col)

전체 교체

private string GetMergedCellSortKey(CombinedRow row, DataGridViewColumn col)
{
    if (row == null || col == null)
        return string.Empty;

    if (col.DataPropertyName == "MLot" ||
        col.Name.Equals("colLot", StringComparison.OrdinalIgnoreCase))
    {
        return row.MLot ?? string.Empty;
    }

    if (col.Name.StartsWith("colExtra_", StringComparison.OrdinalIgnoreCase))
    {
        string value;

        if (TryGetExtraValue(row, col.Name, out value))
        {
            value = NormalizeFilterValue(value);

            if (value == "(null)")
                return string.Empty;

            double numericValue;
            if (double.TryParse(value, out numericValue))
                return numericValue.ToString("000000000000000.000000");

            return value;
        }

        return string.Empty;
    }

    string dp = col.DataPropertyName;

    if (!string.IsNullOrWhiteSpace(dp))
    {
        var prop = typeof(CombinedRow).GetProperty(dp);

        if (prop != null)
        {
            var value = prop.GetValue(row);
            return value == null ? string.Empty : Convert.ToString(value);
        }
    }

    return string.Empty;
}



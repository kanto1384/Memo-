private void FillLotByIndex(CombinedRow row)

전체 교체

private void FillLotByIndex(CombinedRow row)
{
    if (row == null)
        return;

    if (!string.IsNullOrWhiteSpace(row.MLot))
        return;

    if (row.SuccessIdx < 0)
        return;

    if (string.IsNullOrWhiteSpace(row.SourceFile))
        return;

    // 1순위: BuildKVIndexForFile에서 미리 계산한 LOT 사용
    if (lotIndexByFile.TryGetValue(row.SourceFile, out var lotMap) &&
        lotMap != null &&
        lotMap.TryGetValue(row.SuccessIdx, out var lot) &&
        !string.IsNullOrWhiteSpace(lot))
    {
        row.MLot = lot;
        return;
    }

    // 2순위: 해당 SuccessIdx 블록의 보관된 pairs에서 규칙대로 LOT 추출
    if (kvIndexByFile.TryGetValue(row.SourceFile, out var fileMap) &&
        fileMap != null &&
        fileMap.TryGetValue(row.SuccessIdx, out var pairs))
    {
        row.MLot = PickLotFromPairs(row.Var, pairs);
    }
}



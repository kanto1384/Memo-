5. LoadOneFileAsync(string file) 전체 교체

이게 이번 1단계의 핵심임.
rows는 결합 생성까지만 쓰고, 로딩 완료 후 비운다.

private async Task LoadOneFileAsync(string file)
{
    SetBusy("파일 읽는 중…", true);

    try
    {
        txtSearchVar.Text = _BizS;
        txtSearchVar.ForeColor = Color.Gray;
        txtSearchVar.Items.Clear();

        isSearchComboInitialized = false;
        activeFilters.Clear();

        lock (locker)
        {
            rows.Clear();
            viewRows.Clear();

            kvIndexByFile.Clear();
            lotIndexByFile.Clear();

            allMergedRows.Clear();
            if (searchMergedRows != null)
                searchMergedRows.Clear();

            mergedRows.Clear();
        }

        await Task.Run(async () =>
        {
            await ParseFileAsync(file);
        });

        int parsedLineCount = rows.Count;

        List<CombinedRow> builtMergedRows = null;

        await Task.Run(() =>
        {
            // 전체 Key/Value 저장이 아니라 필요한 Key만 저장하는 BuildKVIndexForFile
            BuildKVIndexForFile(file);

            IEnumerable<LogRow> forMerged = rows.AsEnumerable();

            if (chkBROnly.Checked)
            {
                forMerged = forMerged.Where(r =>
                    (r.Var ?? "").StartsWith("BR_", StringComparison.OrdinalIgnoreCase));
            }

            builtMergedRows = BuildMergedQueue(
                forMerged
                    .OrderBy(r => r.SourceFile, StringComparer.OrdinalIgnoreCase)
                    .ThenBy(r => r.LineIndex)
            );
        });

        allMergedRows = builtMergedRows ?? new List<CombinedRow>();

        // 콤보박스 BR 목록 생성
        var mVarValues = allMergedRows
            .Select(r => r.Var)
            .Where(v =>
                !string.IsNullOrWhiteSpace(v) &&
                v.StartsWith("BR_", StringComparison.OrdinalIgnoreCase))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(v => v, StringComparer.OrdinalIgnoreCase)
            .ToList();

        foreach (var val in mVarValues)
        {
            if (!txtSearchVar.Items.Contains(val))
                txtSearchVar.Items.Add(val);
        }

        isSearchComboInitialized = true;

        // 핵심:
        // 결합 보기에서는 rows/viewRows를 계속 들고 있을 필요가 없음.
        rows.Clear();
        rows.TrimExcess();

        viewRows.Clear();
        viewRows.TrimExcess();

        bsLines.DataSource = null;

        searchMergedRows = null;

        // allMergedRows 기준으로 화면 표시/필터/동적컬럼 구성
        ApplyMergedView(true, true);

        GC.Collect();
        GC.WaitForPendingFinalizers();
        GC.Collect();

        statusLabel.Text =
            $"완료: {Path.GetFileName(file)} / 라인 {parsedLineCount:N0} / 결합 {allMergedRows.Count:N0}건";

        UpdateStatusLabel();
    }
    catch (Exception ex)
    {
        statusLabel.Text = "오류 발생";
        MessageBox.Show(ex.ToString(), "오류", MessageBoxButtons.OK, MessageBoxIcon.Error);
    }
    finally
    {
        SetBusy(statusLabel.Text, false);
    }
}



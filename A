private bool ShouldKeepKvKeyForBiz(string varName, string key)
{
    if (string.IsNullOrWhiteSpace(key))
        return false;

    var targetKeys = new List<string>();

    // 1) table.json LOT_KEY_RULES
    if (!string.IsNullOrWhiteSpace(varName) &&
        lotKeyRules != null &&
        lotKeyRules.TryGetValue(varName, out var lotRuleKeys) &&
        lotRuleKeys != null)
    {
        targetKeys.AddRange(lotRuleKeys);
    }

    // 2) table.json DEFAULT_LOT_KEYS
    if (defaultLotKeys != null)
        targetKeys.AddRange(defaultLotKeys);

    // 3) 안전 기본 LOT 후보
    targetKeys.AddRange(new[]
    {
        "OUT_LOTID",
        "INPUT_LOTID",
        "INPUT_CSTID",
        "PROD_LOTID",
        "LOTID",
        "LOT_ID",
        "CSTID"
    });

    // 4) table.json BIZ_KEY_RULES
    // 중요: extraKeyRules 아님. LoadRules()에서 bizKeyRules에 들어간다.
    if (!string.IsNullOrWhiteSpace(varName) &&
        bizKeyRules != null &&
        bizKeyRules.TryGetValue(varName, out var bizKeys) &&
        bizKeys != null)
    {
        targetKeys.AddRange(bizKeys);
    }

    return targetKeys
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Any(x => string.Equals(x, key, StringComparison.OrdinalIgnoreCase));
}



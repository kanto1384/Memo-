4. LoadOneFileAsync 전체 교체

교체 대상

private async Task LoadOneFileAsync(string file)

전체 교체

private async Task LoadOneFileAsync(string file)
{
    SetBusy("파일 읽는 중…", true);

    try
    {
        txtSearchVar.Text = _BizS;
        txtSearchVar.ForeColor = Color.Gray;
        txtSearchVar.Items.Clear();

        isSearchComboInitialized = false;
        activeFilters.Clear();

        lock (locker)
        {
            rows.Clear();
            viewRows.Clear();

            kvIndexByFile.Clear();
            lotIndexByFile.Clear();

            allMergedRows.Clear();
            searchMergedRows.Clear();
            mergedRows.Clear();
        }

        await Task.Run(async () =>
        {
            await ParseFileAsync(file);
        });

        // 경량 모드:
        // BuildKVIndexForFile(file) 호출하지 않음.
        // JSON 동적 컬럼 / KV 전체 인덱스 OFF.

        ApplyFilterAndBind();

        statusLabel.Text = $"완료: {Path.GetFileName(file)}  라인 {rows.Count}";

        // 콤보박스 BR 목록은 rows가 살아있을 때 한 번만 만든다.
        if (!isSearchComboInitialized)
        {
            var mVarValues = rows
                .Select(r => r.Var)
                .Where(v =>
                    !string.IsNullOrWhiteSpace(v) &&
                    v.StartsWith("BR_", StringComparison.OrdinalIgnoreCase))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(v => v, StringComparer.OrdinalIgnoreCase)
                .ToList();

            foreach (var val in mVarValues)
            {
                if (!txtSearchVar.Items.Contains(val))
                    txtSearchVar.Items.Add(val);
            }

            isSearchComboInitialized = true;
        }

        // 핵심:
        // 결합 보기 생성 후 rows/viewRows는 더 이상 보관하지 않는다.
        // 상세보기는 ReadBlockRange()로 파일에서 다시 읽는다.
        rows.Clear();
        rows.TrimExcess();

        viewRows.Clear();
        viewRows.TrimExcess();

        bsLines.DataSource = null;

        // 대용량 파일 로딩 직후 한 번만 강제 회수
        GC.Collect();
        GC.WaitForPendingFinalizers();
        GC.Collect();

        UpdateStatusLabel();

        statusLabel.Text =
            $"완료: {Path.GetFileName(file)} / 결합 {allMergedRows.Count:N0}건 / 경량 모드";
    }
    catch (Exception ex)
    {
        statusLabel.Text = "오류 발생";
        MessageBox.Show(ex.ToString(), "오류", MessageBoxButtons.OK, MessageBoxIcon.Error);
    }
    finally
    {
        SetBusy(statusLabel.Text, false);
    }
}



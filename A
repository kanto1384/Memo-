9. MergedRowContainsSearchKey(...) 전체 교체

교체 대상

private bool MergedRowContainsSearchKey(CombinedRow row, string key)

전체 교체

private bool MergedRowContainsSearchKey(CombinedRow row, string key)
{
    if (row == null)
        return false;

    if (string.IsNullOrWhiteSpace(key))
        return true;

    if (!string.IsNullOrWhiteSpace(row.Var) &&
        row.Var.IndexOf(key, StringComparison.OrdinalIgnoreCase) >= 0)
        return true;

    if (!string.IsNullOrWhiteSpace(row.Status) &&
        row.Status.IndexOf(key, StringComparison.OrdinalIgnoreCase) >= 0)
        return true;

    if (!string.IsNullOrWhiteSpace(row.MLot) &&
        row.MLot.IndexOf(key, StringComparison.OrdinalIgnoreCase) >= 0)
        return true;

    if (row.ExtraValues != null)
    {
        foreach (string value in row.ExtraValues.Values)
        {
            if (!string.IsNullOrWhiteSpace(value) &&
                value.IndexOf(key, StringComparison.OrdinalIgnoreCase) >= 0)
            {
                return true;
            }
        }
    }

    return false;
}



전체 교체

private void gridMerged_CellFormatting(object sender, DataGridViewCellFormattingEventArgs e)
{
    if (e.RowIndex < 0)
        return;

    var col = gridMerged.Columns[e.ColumnIndex];
    if (col == null)
        return;

    if (!col.Name.StartsWith("colExtra_", StringComparison.OrdinalIgnoreCase))
        return;

    var row = gridMerged.Rows[e.RowIndex].DataBoundItem as CombinedRow;

    if (row == null)
    {
        e.Value = "";
        e.FormattingApplied = true;
        return;
    }

    string value;
    if (TryGetExtraValue(row, col.Name, out value))
        e.Value = value;
    else
        e.Value = "";

    e.FormattingApplied = true;
}



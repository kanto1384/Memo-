2. gridMerged_CellFormatting(...) 전체 추가/교체

교체 대상

private void gridMerged_CellFormatting(object sender, DataGridViewCellFormattingEventArgs e)

전체 교체

private void gridMerged_CellFormatting(object sender, DataGridViewCellFormattingEventArgs e)
{
    if (e.RowIndex < 0)
        return;

    if (e.ColumnIndex < 0 || e.ColumnIndex >= gridMerged.Columns.Count)
        return;

    DataGridViewColumn col = gridMerged.Columns[e.ColumnIndex];

    if (col == null)
        return;

    if (!col.Name.StartsWith("colExtra_", StringComparison.OrdinalIgnoreCase))
        return;

    CombinedRow row = gridMerged.Rows[e.RowIndex].DataBoundItem as CombinedRow;

    if (row == null)
    {
        e.Value = "";
        e.FormattingApplied = true;
        return;
    }

    string dynamicKey = "";
    int dynamicIndex = -1;

    // 1순위: 컬럼 Tag 사용
    if (col.Tag is ValueTuple<string, int> tagTuple)
    {
        dynamicKey = tagTuple.Item1;
        dynamicIndex = tagTuple.Item2;
    }
    else
    {
        // 2순위: 컬럼 Name 파싱
        TryParseDynamicColumnName(col.Name, out dynamicKey, out dynamicIndex);
    }

    if (string.IsNullOrWhiteSpace(dynamicKey) || dynamicIndex < 0)
    {
        e.Value = "";
        e.FormattingApplied = true;
        return;
    }

    string value = GetDynamicValueInRowRange(row, dynamicKey, dynamicIndex);

    e.Value = value ?? "";
    e.FormattingApplied = true;
}

이게 들어가야 LOT 뒤에 생성된 table.json 컬럼 값이 실제 그리드에 표시됨.



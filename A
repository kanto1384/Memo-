private void ShowFilterSearchDialog(string colKey, List<string> allValues)

아래 코드로 전체 교체

private void ShowFilterSearchDialog(string colKey, List<string> allValues)
{
    Form searchForm = new Form();
    searchForm.Text = "필터 검색";
    searchForm.Width = 400;
    searchForm.Height = 500;

    TextBox searchBox = new TextBox { Dock = DockStyle.Top };
    ListBox valueListBox = new ListBox
    {
        Dock = DockStyle.Fill,
        SelectionMode = SelectionMode.MultiExtended
    };

    // 필터 목록도 너무 많으면 UI가 버벅이므로 제한
    List<string> baseValues = allValues
        .Take(5000)
        .ToList();

    valueListBox.DataSource = baseValues.ToList();

    searchBox.TextChanged += (s, e) =>
    {
        var filteredValues = baseValues
            .Where(v => v.IndexOf(searchBox.Text, StringComparison.OrdinalIgnoreCase) >= 0)
            .Take(5000)
            .ToList();

        valueListBox.DataSource = filteredValues;
    };

    Button okButton = new Button { Text = "확인", Dock = DockStyle.Bottom };

    okButton.Click += (s, e) =>
    {
        if (!activeFilters.ContainsKey(colKey))
            activeFilters[colKey] = new List<string>();
        else
            activeFilters[colKey].Clear();

        foreach (string selectedValue in valueListBox.SelectedItems)
        {
            activeFilters[colKey].Add(selectedValue);
        }

        SyncMergedVarFilterToSearchBox(colKey);

        bool rebuildDynamicColumns =
            string.Equals(colKey, "Var", StringComparison.OrdinalIgnoreCase);

        ApplyFilters(rebuildDynamicColumns);

        searchForm.Close();
    };

    searchForm.Controls.Add(okButton);
    searchForm.Controls.Add(valueListBox);
    searchForm.Controls.Add(searchBox);

    searchForm.ShowDialog();
}



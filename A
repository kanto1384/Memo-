3. 새 메서드 추가

추가 위치

LoadOneFileAsync(...) 아래쪽 또는 ApplyFilterAndBind() 위쪽.

private void FillLotAndJsonValuesLightweight(string file, List<CombinedRow> targetRows)
{
    if (targetRows == null || targetRows.Count == 0)
        return;

    string sourceFile = Path.GetFileName(file);

    var rowsByFile = targetRows
        .Where(r =>
            r != null &&
            string.Equals(r.SourceFile, sourceFile, StringComparison.OrdinalIgnoreCase) &&
            r.StartIdx >= 0)
        .OrderBy(r => r.StartIdx)
        .ToList();

    if (rowsByFile.Count == 0)
        return;

    // table.json 기준으로 필요한 Key만 미리 구성
    var jsonKeysByBiz = new Dictionary<string, HashSet<string>>(StringComparer.OrdinalIgnoreCase);

    if (extraKeyRules != null)
    {
        foreach (var rule in extraKeyRules)
        {
            if (string.IsNullOrWhiteSpace(rule.Key))
                continue;

            if (rule.Value == null || rule.Value.Length == 0)
                continue;

            jsonKeysByBiz[rule.Key] = new HashSet<string>(
                rule.Value.Where(x => !string.IsNullOrWhiteSpace(x)),
                StringComparer.OrdinalIgnoreCase
            );
        }
    }

    int nextRowIndex = 0;
    var activeRows = new List<CombinedRow>();

    int lineIndex = -1;

    var kvRx = new Regex(
        @"^\s*\[(?<idx>\d+)\s*:\s*(?<key>[^\]]+)\]\s*:\s*(?<val>.*)$",
        RegexOptions.Compiled | RegexOptions.IgnoreCase);

    using (var fs = new FileStream(
        file,
        FileMode.Open,
        FileAccess.Read,
        FileShare.ReadWrite | FileShare.Delete))
    using (var sr = new StreamReader(fs, Encoding.UTF8, true, 1024 * 64))
    {
        string line;

        while ((line = sr.ReadLine()) != null)
        {
            lineIndex++;

            // 현재 라인에 진입한 결합 Row 활성화
            while (nextRowIndex < rowsByFile.Count &&
                   rowsByFile[nextRowIndex].StartIdx <= lineIndex)
            {
                activeRows.Add(rowsByFile[nextRowIndex]);
                nextRowIndex++;
            }

            // 범위가 끝난 Row 제거
            activeRows.RemoveAll(r =>
                r.EndIdx >= 0 &&
                r.EndIdx < lineIndex);

            if (activeRows.Count == 0)
                continue;

            var m = kvRx.Match(line);
            if (!m.Success)
                continue;

            int idx;
            if (!int.TryParse(m.Groups["idx"].Value, out idx))
                idx = 0;

            string key = m.Groups["key"].Value.Trim();
            string val = m.Groups["val"].Value.Trim();

            if (string.IsNullOrWhiteSpace(key))
                continue;

            foreach (var row in activeRows)
            {
                // 1) LOT 표시
                if (string.IsNullOrWhiteSpace(row.MLot) &&
                    IsLotKey(key))
                {
                    row.MLot = val;
                }

                // 2) table.json 지정 Key만 저장
                if (string.IsNullOrWhiteSpace(row.Var))
                    continue;

                if (!jsonKeysByBiz.TryGetValue(row.Var, out var jsonKeys))
                    continue;

                if (!jsonKeys.Contains(key))
                    continue;

                if (row.ExtraValues == null)
                    row.ExtraValues = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

                string colName = MakeExtraColumnName(key, idx);
                row.ExtraValues[colName] = val;
            }
        }
    }
}



2. GridMerged_CellDoubleClick 전체 교체

교체 대상

private void GridMerged_CellDoubleClick(object sender, DataGridViewCellEventArgs e)

전체 교체

private void GridMerged_CellDoubleClick(object sender, DataGridViewCellEventArgs e)
{
    if (e.RowIndex < 0 || e.RowIndex >= gridMerged.Rows.Count)
        return;

    var row = gridMerged.Rows[e.RowIndex].DataBoundItem as CombinedRow;
    if (row == null)
        return;

    if (e.ColumnIndex == colIndexMergedStart || e.ColumnIndex == colIndexMergedEnd)
    {
        string fp = Path.Combine(txtFolder.Text, row.SourceFile);

        try
        {
            Process.Start(new ProcessStartInfo(fp) { UseShellExecute = true });
        }
        catch (Exception ex)
        {
            MessageBox.Show(ex.Message, "파일 열기 오류");
        }

        return;
    }

    string text = ReadBlockRange(row.SourceFile, row.StartIdx, row.EndIdx);

    ShowText(
        text,
        $"{row.Var} 결합 상세 (#{row.StartIdx + 1} ~ {(row.EndIdx < 0 ? "…" : "#" + (row.EndIdx + 1).ToString())})"
    );
}



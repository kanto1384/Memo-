3. OpenMenuItem_Click 전체 교체

교체 대상

private async void OpenMenuItem_Click(object sender, EventArgs e)

전체 교체

private async void OpenMenuItem_Click(object sender, EventArgs e)
{
    var selectedRows = gridMerged.SelectedRows
        .Cast<DataGridViewRow>()
        .OrderBy(row => row.Index)
        .ToList();

    if (!selectedRows.Any())
        return;

    var rowSnapshots = selectedRows
        .Select(r => r.DataBoundItem as CombinedRow)
        .Where(r => r != null)
        .ToList();

    if (rowSnapshots.Count == 0)
        return;

    (string text, string title) result = await Task.Run(() =>
    {
        var sb = new StringBuilder();
        var titles = new List<string>();

        foreach (CombinedRow row in rowSnapshots)
        {
            string block = ReadBlockRange(row.SourceFile, row.StartIdx, row.EndIdx);

            if (!string.IsNullOrWhiteSpace(block))
            {
                sb.AppendLine(block);
                sb.AppendLine();
            }

            titles.Add($"{row.Var} 상세 (#{row.StartIdx + 1} ~ {(row.EndIdx < 0 ? "…" : "#" + (row.EndIdx + 1).ToString())})");
        }

        string combinedTitle;

        if (titles.Count > 2)
            combinedTitle = $"선택 항목 결합: {string.Join(", ", titles.Take(2))} ... ({titles.Count}개)";
        else
            combinedTitle = $"선택 항목 결합: {string.Join(", ", titles)}";

        return (sb.ToString(), combinedTitle);
    });

    if (result.text.Length > 0)
        ShowText(result.text, result.title);
}



3. FillLotByIndex(CombinedRow row) 전체 교체

LOT이 엉뚱하게 잡히는 문제 때문에 SuccessIdx만 보지 말고 StartIdx~EndIdx 범위도 fallback으로 보게 수정한다.

private void FillLotByIndex(CombinedRow row)
{
    if (row == null)
        return;

    if (!string.IsNullOrWhiteSpace(row.MLot))
        return;

    if (string.IsNullOrWhiteSpace(row.SourceFile))
        return;

    if (!kvIndexByFile.TryGetValue(row.SourceFile, out var fileMap) || fileMap == null)
        return;

    // 1순위: SuccessIdx 블록
    if (row.SuccessIdx >= 0)
    {
        if (lotIndexByFile.TryGetValue(row.SourceFile, out var lotMap) &&
            lotMap != null &&
            lotMap.TryGetValue(row.SuccessIdx, out var lot) &&
            !string.IsNullOrWhiteSpace(lot))
        {
            row.MLot = lot;
            return;
        }

        if (fileMap.TryGetValue(row.SuccessIdx, out var successPairs) &&
            successPairs != null)
        {
            string lot = PickLotFromPairs(row.Var, successPairs);

            if (!string.IsNullOrWhiteSpace(lot))
            {
                row.MLot = lot;
                return;
            }
        }
    }

    // 2순위: StartIdx~EndIdx 범위에서 아래쪽 블록 우선
    // STEP_5가 STEP_3보다 아래면 STEP_5 LOT이 우선됨.
    int start = row.StartIdx;
    int end = row.EndIdx;

    if (start < 0 && row.SuccessIdx >= 0)
        start = row.SuccessIdx;

    if (end < 0 && row.SuccessIdx >= 0)
        end = row.SuccessIdx;

    if (start < 0 || end < 0)
        return;

    if (start > end)
    {
        int temp = start;
        start = end;
        end = temp;
    }

    foreach (var block in fileMap
        .Where(x => x.Key >= start && x.Key <= end)
        .OrderByDescending(x => x.Key))
    {
        string lot = PickLotFromPairs(row.Var, block.Value);

        if (!string.IsNullOrWhiteSpace(lot))
        {
            row.MLot = lot;
            return;
        }
    }
}



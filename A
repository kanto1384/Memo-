private async Task RegisterAutoLoginScriptAsync()
{
    if (_web.CoreWebView2 == null)
        return;

    if (string.IsNullOrWhiteSpace(_loginPwFromJson))
        return;

    var idJson = JsonSerializer.Serialize(_loginIdFromJson ?? "");
    var pwJson = JsonSerializer.Serialize(_loginPwFromJson ?? "");

    var js = $@"
(() => {{
  const ID = {idJson};
  const PW = {pwJson};
  const SCRIPT_VERSION = 'lock-v4';

  if (window.__gateOneAutomationVersion === SCRIPT_VERSION)
    return;

  const inputSetter =
    Object.getOwnPropertyDescriptor(
      HTMLInputElement.prototype,
      'value'
    )?.set;

  function setInput(element, value) {{
    if (!element)
      return false;

    try {{
      element.focus();

      if (inputSetter)
        inputSetter.call(element, value);
      else
        element.value = value;

      element.dispatchEvent(
        new Event('input', {{
          bubbles: true
        }})
      );

      element.dispatchEvent(
        new Event('change', {{
          bubbles: true
        }})
      );

      element.dispatchEvent(
        new KeyboardEvent('keydown', {{
          bubbles: true
        }})
      );

      element.dispatchEvent(
        new KeyboardEvent('keyup', {{
          bubbles: true
        }})
      );

      element.blur();

      return element.value === value;
    }}
    catch {{
      return false;
    }}
  }}

  function isVisible(element) {{
    if (!element)
      return false;

    if (!document.contains(element))
      return false;

    try {{
      const style = window.getComputedStyle(element);
      const rect = element.getBoundingClientRect();

      return (
        style.display !== 'none' &&
        style.visibility !== 'hidden' &&
        style.opacity !== '0' &&
        rect.width > 0 &&
        rect.height > 0
      );
    }}
    catch {{
      return false;
    }}
  }}

  /*
   * 최초 로그인 화면 자동 입력
   */
  function tryFillLogin() {{
    if (!ID || !PW)
      return false;

    const idElement = document.querySelector(
      'input#USERID.input_txt, ' +
      'input#USERID, ' +
      'input[name=""USERID""]'
    );

    const passwordElement = document.querySelector(
      'input#PASSWD.input_txt, ' +
      'input#PASSWD, ' +
      'input[name=""PASSWD""]'
    );

    if (!idElement || !passwordElement)
      return false;

    const idResult = setInput(idElement, ID);
    const passwordResult = setInput(passwordElement, PW);

    return idResult && passwordResult;
  }}

  /*
   * ready:
   *   새로운 잠금 화면 처리 가능
   *
   * scheduled:
   *   비밀번호 입력 후 확인 클릭 대기
   *
   * attempted:
   *   현재 표시된 잠금 화면에서 이미 한 번 클릭함
   */
  let lockState = 'ready';
  let unlockTimer = null;

  /*
   * 직전 확인 버튼 클릭 시간.
   * 클릭 직후 발생하는 DOM 변화를 구분하는 데 사용.
   */
  let lastUnlockClickTime = 0;

  function getLockInput() {{
    return document.querySelector(
      'input#lock_passwd.txt_box5, ' +
      'input#lock_passwd, ' +
      'input[name=""lock_passwd""]'
    );
  }}

  function getLockButton() {{
    return document.querySelector(
      'a[onclick*=""lock_screen_login""][title=""확인""], ' +
      'a[onclick*=""lock_screen_login""]'
    );
  }}

  function scheduleUnlock() {{
    if (lockState !== 'ready')
      return false;

    if (!PW)
      return false;

    const lockInput = getLockInput();
    const lockButton = getLockButton();

    if (!isVisible(lockInput))
      return false;

    if (!isVisible(lockButton))
      return false;

    /*
     * 먼저 상태를 변경한다.
     * 비밀번호 입력 이벤트로 감시기가 실행돼도
     * 중복 예약되지 않는다.
     */
    lockState = 'scheduled';

    if (!setInput(lockInput, PW)) {{
      lockState = 'attempted';
      return false;
    }}

    const delay =
      1000 + Math.floor(Math.random() * 2001);

    unlockTimer = window.setTimeout(() => {{
      unlockTimer = null;

      const currentInput = getLockInput();
      const currentButton = getLockButton();

      if (!isVisible(currentInput)) {{
        lockState = 'ready';
        return;
      }}

      if (!isVisible(currentButton)) {{
        lockState = 'attempted';
        return;
      }}

      /*
       * 사용자가 대기 중 직접 값을 변경했다면
       * 자동 클릭하지 않는다.
       */
      if (currentInput.value !== PW) {{
        lockState = 'attempted';
        return;
      }}

      lockState = 'attempted';
      lastUnlockClickTime = Date.now();

      try {{
        currentButton.click();
      }}
      catch {{
        // 실패해도 현재 화면에서 반복하지 않음
      }}
    }}, delay);

    return true;
  }}

  function checkLockScreen() {{
    const lockInput = getLockInput();
    const lockVisible = isVisible(lockInput);

    /*
     * 잠금 화면이 보이지 않는 경우
     */
    if (!lockVisible) {{
      if (unlockTimer !== null) {{
        window.clearTimeout(unlockTimer);
        unlockTimer = null;
      }}

      /*
       * 이전 잠금 화면이 사라졌으므로
       * 다음 잠금 화면을 즉시 처리할 수 있도록 초기화.
       *
       * 기존의 '3초 이상 사라져야 초기화' 조건을 제거함.
       */
      lockState = 'ready';
      return;
    }}

    /*
     * 잠금 화면이 보이는 경우.
     *
     * attempted 상태라면 같은 화면이므로 재실행하지 않는다.
     * ready 상태일 때만 새 잠금 화면으로 판단한다.
     */
    if (lockState === 'ready')
      scheduleUnlock();
  }}

  /*
   * 최초 로그인 자동입력
   * 최대 10초
   */
  let loginTryCount = 0;

  const loginTimer = window.setInterval(() => {{
    loginTryCount++;

    if (
      tryFillLogin() ||
      loginTryCount >= 40
    ) {{
      window.clearInterval(loginTimer);
    }}
  }}, 250);

  /*
   * 잠금 팝업의 추가/삭제뿐 아니라
   * display, class 변경도 즉시 감지한다.
   */
  const lockObserver = new MutationObserver(() => {{
    checkLockScreen();
  }});

  lockObserver.observe(document, {{
    childList: true,
    subtree: true,
    attributes: true,
    attributeFilter: [
      'style',
      'class',
      'hidden'
    ]
  }});

  /*
   * 감지 누락 대비.
   * 1초에 한 번 DOM만 확인하며 서버 통신 없음.
   */
  window.setInterval(() => {{
    checkLockScreen();
  }}, 1000);

  window.__gateOneAutomationVersion =
    SCRIPT_VERSION;

  checkLockScreen();
}})();";

    // 이후 생성되는 문서에 등록
    await _web.CoreWebView2
        .AddScriptToExecuteOnDocumentCreatedAsync(js);

    // 현재 열려 있는 문서에도 적용
    try
    {
        await _web.CoreWebView2
            .ExecuteScriptAsync(js);
    }
    catch
    {
        // 현재 문서가 준비 전이면
        // 등록된 스크립트가 다음 문서에서 실행됨
    }
}

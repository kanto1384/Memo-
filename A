8. UpdateDynamicColumnsForSearch() 전체 교체

교체 대상

private void UpdateDynamicColumnsForSearch()

전체 교체

private void UpdateDynamicColumnsForSearch()
{
    foreach (var name in currentDynamicCols.ToList())
    {
        if (gridMerged.Columns.Contains(name))
            gridMerged.Columns.Remove(name);
    }

    currentDynamicCols.Clear();

    string raw = txtSearchVar?.Text?.Trim() ?? "";

    if (string.IsNullOrWhiteSpace(raw) || raw == _BizS)
    {
        gridMerged.Refresh();
        return;
    }

    string[] bizTokens = raw
        .Split('|')
        .Select(s => s.Trim())
        .Where(s =>
            !string.IsNullOrWhiteSpace(s) &&
            s.StartsWith("BR_", StringComparison.OrdinalIgnoreCase))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToArray();

    if (bizTokens.Length == 0)
    {
        gridMerged.Refresh();
        return;
    }

    var allowedKeys = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    foreach (string biz in bizTokens)
    {
        if (extraKeyRules != null &&
            extraKeyRules.TryGetValue(biz, out var keys) &&
            keys != null)
        {
            foreach (string key in keys)
            {
                if (!string.IsNullOrWhiteSpace(key))
                    allowedKeys.Add(key);
            }
        }
    }

    if (allowedKeys.Count == 0)
    {
        gridMerged.Refresh();
        return;
    }

    var colNames = new List<string>();

    foreach (var row in mergedRows)
    {
        if (row?.ExtraValues == null)
            continue;

        foreach (string colName in row.ExtraValues.Keys)
        {
            string dynamicKey;
            int dynamicIndex;

            if (!TryParseDynamicColumnName(colName, out dynamicKey, out dynamicIndex))
                continue;

            if (!allowedKeys.Contains(dynamicKey))
                continue;

            if (!colNames.Contains(colName, StringComparer.OrdinalIgnoreCase))
                colNames.Add(colName);
        }
    }

    if (colNames.Count == 0)
    {
        gridMerged.Refresh();
        return;
    }

    colNames = colNames
        .OrderBy(c =>
        {
            string key;
            int idx;
            if (TryParseDynamicColumnName(c, out key, out idx))
                return key;
            return c;
        }, StringComparer.OrdinalIgnoreCase)
        .ThenBy(c =>
        {
            string key;
            int idx;
            if (TryParseDynamicColumnName(c, out key, out idx))
                return idx;
            return 0;
        })
        .ToList();

    int lotIdx = gridMerged.Columns
        .Cast<DataGridViewColumn>()
        .FirstOrDefault(c =>
            c.DataPropertyName == "MLot" ||
            c.Name.Equals("colLot", StringComparison.OrdinalIgnoreCase))
        ?.Index ?? -1;

    int insertAt = lotIdx >= 0 ? lotIdx + 1 : gridMerged.Columns.Count;

    foreach (string colName in colNames)
    {
        if (gridMerged.Columns.Contains(colName))
            continue;

        string dynamicKey;
        int dynamicIndex;

        if (!TryParseDynamicColumnName(colName, out dynamicKey, out dynamicIndex))
            continue;

        var col = new DataGridViewTextBoxColumn
        {
            Name = colName,
            HeaderText = $"{dynamicKey}[{dynamicIndex}]",
            Width = 140,
            SortMode = DataGridViewColumnSortMode.Programmatic,
            Tag = (dynamicKey, dynamicIndex)
        };

        gridMerged.Columns.Insert(insertAt++, col);
        currentDynamicCols.Add(colName);
    }

    gridMerged.Refresh();
}



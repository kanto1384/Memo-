3. 메모리 줄이기: ApplyFilterAndBind() 전체 교체

지금 결합 보기에서도 viewRows를 만들고 BindLines(viewRows)까지 하고 있으면 메모리 한 벌 더 잡음.
결합 보기에서는 라인 보기용 viewRows를 만들 필요 없음.

교체 대상

private void ApplyFilterAndBind()

전체 교체

private void ApplyFilterAndBind()
{
    // =========================
    // 1. 라인 보기 처리
    // =========================
    // 결합 보기(chkCombine.Checked == true)에서는 viewRows를 만들지 않는다.
    // 이게 rows 한 벌을 더 잡아먹는 주요 원인 중 하나임.
    if (!chkCombine.Checked)
    {
        IEnumerable<LogRow> q = rows;

        if (chkBROnly.Checked)
        {
            q = q.Where(r =>
                (r.Var ?? string.Empty).StartsWith("BR_", StringComparison.OrdinalIgnoreCase));
        }

        q = FilterBySearch(q);

        viewRows = q
            .OrderBy(r => r.SourceFile, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.LineIndex)
            .ToList();

        BindLines(viewRows);
    }
    else
    {
        viewRows.Clear();
        viewRows.TrimExcess();

        bsLines.DataSource = null;
    }

    // =========================
    // 2. 결합 보기 원본 생성
    // =========================
    var forMerged = rows.AsEnumerable();

    if (chkBROnly.Checked)
    {
        forMerged = forMerged.Where(r =>
            (r.Var ?? "").StartsWith("BR_", StringComparison.OrdinalIgnoreCase));
    }

    allMergedRows = BuildMergedQueue(
        forMerged
            .OrderBy(r => r.SourceFile, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.LineIndex)
    );

    // =========================
    // 3. 비즈 검색창 한 줄 검색
    // =========================
    string[] keys = GetSearchKeys();

    IEnumerable<CombinedRow> source = allMergedRows;

    if (keys.Length > 0)
    {
        source = source.Where(r =>
            keys.Any(k =>
                !string.IsNullOrWhiteSpace(r.Var) &&
                r.Var.IndexOf(k, StringComparison.OrdinalIgnoreCase) >= 0));
    }

    // searchMergedRows는 필터 기준 원본으로 유지
    searchMergedRows = source.ToList();

    // 컬럼 필터가 있으면 적용
    mergedRows = ApplyMergedColumnFilters(searchMergedRows, activeFilters)
        .ToList();

    bsMerged.DataSource = null;
    bsMerged.DataSource = mergedRows;

    gridMerged.DataSource = bsMerged;
    bs.DataSource = gridMerged.DataSource;

    UpdateDynamicColumnsForSearch();

    gridMerged.Invalidate();

    ToggleMode();
    UpdateStatusLabel();
}



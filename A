private void FillLotAndJsonValuesLightweight(List<CombinedRow> targetRows, bool includeJson)
{
    if (targetRows == null || targetRows.Count == 0)
        return;

    var fileGroups = targetRows
        .Where(r =>
            r != null &&
            !string.IsNullOrWhiteSpace(r.SourceFile) &&
            r.StartIdx >= 0)
        .GroupBy(r => r.SourceFile, StringComparer.OrdinalIgnoreCase)
        .ToList();

    if (fileGroups.Count == 0)
        return;

    var kvRx = new Regex(
        @"^\s*\[(?<idx>\d+)\s*:\s*(?<key>[^\]]+)\]\s*:\s*(?<val>.*)$",
        RegexOptions.Compiled | RegexOptions.IgnoreCase);

    foreach (var fileGroup in fileGroups)
    {
        string sourceFile = fileGroup.Key;
        string fullPath = Path.Combine(txtFolder.Text, sourceFile);

        if (!File.Exists(fullPath))
            continue;

        var rowsByFile = fileGroup
            .OrderBy(r => r.StartIdx)
            .ToList();

        int nextRowIndex = 0;
        var activeRows = new List<CombinedRow>();

        int lineIndex = -1;

        using (var fs = new FileStream(
            fullPath,
            FileMode.Open,
            FileAccess.Read,
            FileShare.ReadWrite | FileShare.Delete))
        using (var sr = new StreamReader(fs, Encoding.UTF8, true, 1024 * 64))
        {
            string line;

            while ((line = sr.ReadLine()) != null)
            {
                lineIndex++;

                while (nextRowIndex < rowsByFile.Count &&
                       rowsByFile[nextRowIndex].StartIdx <= lineIndex)
                {
                    activeRows.Add(rowsByFile[nextRowIndex]);
                    nextRowIndex++;
                }

                activeRows.RemoveAll(r =>
                    r.EndIdx >= 0 &&
                    r.EndIdx < lineIndex);

                if (activeRows.Count == 0)
                    continue;

                var m = kvRx.Match(line);
                if (!m.Success)
                    continue;

                int idx;
                if (!int.TryParse(m.Groups["idx"].Value, out idx))
                    idx = 0;

                string key = m.Groups["key"].Value.Trim();
                string val = m.Groups["val"].Value.Trim();

                if (string.IsNullOrWhiteSpace(key))
                    continue;

                foreach (var row in activeRows)
                {
                    // LOT 표시
                    if (string.IsNullOrWhiteSpace(row.MLot) &&
                        IsLotKey(key))
                    {
                        row.MLot = val;
                    }

                    if (!includeJson)
                        continue;

                    if (string.IsNullOrWhiteSpace(row.Var))
                        continue;

                    if (extraKeyRules == null)
                        continue;

                    if (!extraKeyRules.TryGetValue(row.Var, out var jsonKeys))
                        continue;

                    if (jsonKeys == null || jsonKeys.Length == 0)
                        continue;

                    bool isTargetKey = jsonKeys.Any(x =>
                        string.Equals(x, key, StringComparison.OrdinalIgnoreCase));

                    if (!isTargetKey)
                        continue;

                    if (row.ExtraValues == null)
                    {
                        row.ExtraValues =
                            new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
                    }

                    string colName = MakeExtraColumnName(key, idx);
                    row.ExtraValues[colName] = val;
                }
            }
        }
    }
}



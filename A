6. ApplyFilterAndBind() 전체 교체

검색 버튼이나 필터 초기화에서 이 메서드가 호출돼도, rows가 비어 있으면 allMergedRows 기준으로만 동작하게 만든다.

private void ApplyFilterAndBind()
{
    // rows가 비어 있으면 이미 경량 로딩 완료 상태.
    // 이때는 allMergedRows 기준으로만 다시 표시한다.
    if (rows == null || rows.Count == 0)
    {
        ApplyMergedView(true, true);
        ToggleMode();
        UpdateStatusLabel();
        return;
    }

    // =========================
    // 1. 라인 보기 처리
    // =========================
    if (!chkCombine.Checked)
    {
        IEnumerable<LogRow> q = rows;

        if (chkBROnly.Checked)
        {
            q = q.Where(r =>
                (r.Var ?? string.Empty).StartsWith("BR_", StringComparison.OrdinalIgnoreCase));
        }

        q = FilterBySearch(q);

        viewRows = q
            .OrderBy(r => r.SourceFile, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.LineIndex)
            .ToList();

        BindLines(viewRows);
    }
    else
    {
        viewRows.Clear();
        viewRows.TrimExcess();

        bsLines.DataSource = null;
    }

    // =========================
    // 2. 결합 보기 원본 생성
    // =========================
    IEnumerable<LogRow> forMerged = rows.AsEnumerable();

    if (chkBROnly.Checked)
    {
        forMerged = forMerged.Where(r =>
            (r.Var ?? "").StartsWith("BR_", StringComparison.OrdinalIgnoreCase));
    }

    allMergedRows = BuildMergedQueue(
        forMerged
            .OrderBy(r => r.SourceFile, StringComparer.OrdinalIgnoreCase)
            .ThenBy(r => r.LineIndex)
    );

    ApplyMergedView(true, true);

    ToggleMode();
    UpdateStatusLabel();
}



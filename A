교체 대상

private void ApplyFilterAndBind()

전체 교체

private void ApplyFilterAndBind()
{
    // 경량 모드:
    // rows는 로딩 후 비워지므로 allMergedRows 기준으로만 표시한다.

    IEnumerable<CombinedRow> source = allMergedRows ?? new List<CombinedRow>();

    string[] keys = GetSearchKeys();

    if (keys.Length > 0)
    {
        source = source.Where(r =>
            keys.Any(k => MergedRowContainsSearchKey(r, k)));
    }

    mergedRows = source.ToList();
    searchMergedRows = mergedRows;

    bsMerged.DataSource = null;
    bsMerged.DataSource = mergedRows;

    gridMerged.DataSource = bsMerged;
    bs.DataSource = gridMerged.DataSource;

    UpdateDynamicColumnsForSearch();

    ToggleMode();
    UpdateStatusLabel();
}



private async Task ApplyMergedViewAsync(bool rebuildSearchBase = true, bool rebuildDynamicColumns = true)

아래 코드로 전체 교체

private async Task ApplyMergedViewAsync(bool rebuildSearchBase = true, bool rebuildDynamicColumns = true)
{
    int version = ++_mergedApplyVersion;

    string oldStatus = statusLabel.Text;

    try
    {
        btnSearch.Enabled = false;
        btnClear.Enabled = false;
        statusLabel.Text = "검색/필터 적용 중...";
        Cursor = Cursors.AppStarting;

        string[] searchKeys = GetSearchKeys();

        Dictionary<string, List<string>> filterSnapshot =
            activeFilters.ToDictionary(
                x => x.Key,
                x => x.Value == null ? new List<string>() : x.Value.ToList(),
                StringComparer.OrdinalIgnoreCase
            );

        List<CombinedRow> allRowsSnapshot = allMergedRows ?? new List<CombinedRow>();
        List<CombinedRow> searchRowsSnapshot = searchMergedRows;

        var result = await Task.Run(() =>
        {
            List<CombinedRow> localSearchRows;

            if (rebuildSearchBase || searchRowsSnapshot == null)
            {
                localSearchRows = FilterMergedBySearchKeys(allRowsSnapshot, searchKeys).ToList();
            }
            else
            {
                localSearchRows = searchRowsSnapshot;
            }

            IEnumerable<CombinedRow> filtered =
                ApplyMergedColumnFilters(localSearchRows, filterSnapshot);

            // 화면 바인딩은 최대 10,000건만.
            // 전체를 DataGridView에 붙이면 메모리/렌더링에서 터짐.
            List<CombinedRow> displayRows =
                filtered
                    .Take(MERGED_DISPLAY_LIMIT + 1)
                    .ToList();

            bool limited = displayRows.Count > MERGED_DISPLAY_LIMIT;

            if (limited)
                displayRows.RemoveAt(displayRows.Count - 1);

            return new
            {
                SearchRows = localSearchRows,
                DisplayRows = displayRows,
                IsLimited = limited
            };
        });

        if (version != _mergedApplyVersion)
            return;

        if (rebuildSearchBase || searchMergedRows == null)
            searchMergedRows = result.SearchRows;

        mergedRows = result.DisplayRows;

        bsMerged.DataSource = mergedRows;

        if (gridMerged.DataSource == null)
            gridMerged.DataSource = bsMerged;

        bs.DataSource = gridMerged.DataSource;

        bsMerged.ResetBindings(false);

        if (rebuildDynamicColumns)
            UpdateDynamicColumnsForSearch();

        gridMerged.Refresh();
        UpdateStatusLabel();

        if (result.IsLimited)
        {
            statusLabel.Text =
                $"완료: 상위 {MERGED_DISPLAY_LIMIT:N0}건만 표시됨. 검색/필터 조건을 더 좁혀야 함.";
        }
        else
        {
            statusLabel.Text = $"완료: {mergedRows.Count:N0}건 표시";
        }
    }
    catch (Exception ex)
    {
        if (version == _mergedApplyVersion)
        {
            statusLabel.Text = "검색/필터 오류";
            MessageBox.Show(ex.ToString(), "검색/필터 오류", MessageBoxButtons.OK, MessageBoxIcon.Error);
        }
    }
    finally
    {
        if (version == _mergedApplyVersion)
        {
            btnSearch.Enabled = true;
            btnClear.Enabled = true;
            Cursor = Cursors.Default;

            if (string.IsNullOrWhiteSpace(statusLabel.Text))
                statusLabel.Text = oldStatus;
        }
    }
}



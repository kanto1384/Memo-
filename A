1. BuildKVIndexForFile(string file) 전체 교체

private void BuildKVIndexForFile(string file)
{
    // 메모리 절감 버전:
    // 모든 Key/Value를 저장하지 않고,
    // LOT 규칙 Key + table.json BIZ_KEY_RULES Key만 저장한다.

    string source = Path.GetFileName(file);

    var fileMap = new Dictionary<int, Dictionary<string, Dictionary<int, string>>>();
    var lotMap = new Dictionary<int, string>();

    int currentHeaderIdx = -1;
    string currentVarName = "";
    Dictionary<string, Dictionary<int, string>> currentPairs = null;

    var kvRx = new Regex(
        @"^\s*\[(?<idx>\d+)\s*:\s*(?<key>[^\]]+)\]\s*:\s*(?<val>.*)$",
        RegexOptions.Compiled | RegexOptions.IgnoreCase
    );

    Action flushBlock = () =>
    {
        if (currentHeaderIdx < 0)
            return;

        if (currentPairs == null || currentPairs.Count == 0)
            return;

        fileMap[currentHeaderIdx] = currentPairs;

        string lot = PickLotFromPairs(currentVarName, currentPairs);

        if (!string.IsNullOrWhiteSpace(lot))
            lotMap[currentHeaderIdx] = lot;
    };

    int lineIndex = -1;

    using (var fs = new FileStream(
        file,
        FileMode.Open,
        FileAccess.Read,
        FileShare.ReadWrite | FileShare.Delete))
    using (var sr = new StreamReader(fs, Encoding.UTF8, true, 1024 * 64))
    {
        string line;

        while ((line = sr.ReadLine()) != null)
        {
            lineIndex++;

            var hm = headRx.Match(line);

            if (hm.Success)
            {
                flushBlock();

                currentHeaderIdx = lineIndex;
                currentPairs = null;
                currentVarName = "";

                string rest = hm.Groups["rest"].Value;
                currentVarName = GetVarFromHeader(source, rest);

                if (string.IsNullOrWhiteSpace(currentVarName) ||
                    !currentVarName.StartsWith("BR_", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                currentPairs = new Dictionary<string, Dictionary<int, string>>(
                    StringComparer.OrdinalIgnoreCase
                );

                continue;
            }

            if (currentHeaderIdx < 0)
                continue;

            if (currentPairs == null)
                continue;

            var kv = kvRx.Match(line);

            if (!kv.Success)
                continue;

            int idx;
            if (!int.TryParse(kv.Groups["idx"].Value, out idx))
                idx = 0;

            string key = kv.Groups["key"].Value.Trim();
            string val = kv.Groups["val"].Value.Trim();

            if (string.IsNullOrWhiteSpace(key))
                continue;

            if (!ShouldKeepKvKeyForBiz(currentVarName, key))
                continue;

            if (!currentPairs.TryGetValue(key, out var byIndex))
            {
                byIndex = new Dictionary<int, string>();
                currentPairs[key] = byIndex;
            }

            byIndex[idx] = val;
        }
    }

    flushBlock();

    lock (locker)
    {
        kvIndexByFile[source] = fileMap;
        lotIndexByFile[source] = lotMap;
    }
}



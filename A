private int GetMaxDynamicIndexInRowRange(CombinedRow row, string key)
{
    if (row == null)
        return -1;

    if (string.IsNullOrWhiteSpace(key))
        return -1;

    if (string.IsNullOrWhiteSpace(row.SourceFile))
        return -1;

    if (!kvIndexByFile.TryGetValue(row.SourceFile, out var fileMap) || fileMap == null)
        return -1;

    int start = row.StartIdx;
    int end = row.EndIdx;

    if (start < 0 && row.SuccessIdx >= 0)
        start = row.SuccessIdx;

    if (end < 0 && row.SuccessIdx >= 0)
        end = row.SuccessIdx;

    if (start < 0 || end < 0)
        return -1;

    if (start > end)
    {
        int temp = start;
        start = end;
        end = temp;
    }

    int maxIdx = -1;

    foreach (var block in fileMap.Where(x => x.Key >= start && x.Key <= end))
    {
        var pairs = block.Value;

        if (pairs == null)
            continue;

        if (!pairs.TryGetValue(key, out var byIndex) || byIndex == null)
            continue;

        foreach (int idx in byIndex.Keys)
        {
            if (idx > maxIdx)
                maxIdx = idx;
        }
    }

    return maxIdx;
}



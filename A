private bool MergedRowContainsSearchKey(CombinedRow row, string key)

아래 코드로 전체 교체

private bool MergedRowContainsSearchKey(CombinedRow row, string key)
{
    if (row == null)
        return false;

    if (string.IsNullOrWhiteSpace(key))
        return true;

    // 대용량 안정화 모드:
    // KV 전체 범위 검색은 하지 않는다.
    // Var / Status / LOT / 파일명 / 시간 / 소요시간만 검색한다.
    string[] baseValues =
    {
        row.Var ?? "",
        row.Status ?? "",
        row.MLot ?? "",
        row.SourceFile ?? "",
        row.StartTs.ToString("yyyy-MM-dd HH:mm:ss.fff"),
        row.SuccessTs.HasValue ? row.SuccessTs.Value.ToString("yyyy-MM-dd HH:mm:ss.fff") : "",
        row.EndTs.HasValue ? row.EndTs.Value.ToString("yyyy-MM-dd HH:mm:ss.fff") : "",
        row.DurationSeconds.HasValue ? row.DurationSeconds.Value.ToString() : ""
    };

    foreach (string value in baseValues)
    {
        if (!string.IsNullOrWhiteSpace(value) &&
            value.IndexOf(key, StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return true;
        }
    }

    return false;
}



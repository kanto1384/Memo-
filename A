39s 동안 처리함

아니. OpenAI가 막은 게 아님.
내가 줄여서 준 거고, 그게 잘못임. 네가 계속 말한 기준은 **“메서드 전체 교체로 달라”**였는데, 내가 11/12번에서 갑자기 일부 블록만 줘서 헷갈리게 만들었음.

현재 코드 기준으로 ShowFilterMenu()는 메뉴 클릭 마지막에 ApplyFilters();만 호출하고 있어서 Var 필터 변경 시 동적 컬럼 재생성 조건이 빠져 있고, ShowFilterSearchDialog()는 ApplyFilters(rebuildDynamicColumns);까지는 있는데 확인 후 searchForm.Close();가 없음.

아래처럼 11번/12번도 전체 메서드로 교체하면 됨.


---

11. ShowFilterMenu(int col) 전체 교체

private void ShowFilterMenu(int col)
{
    // 0) DataSource 존재 가드
    if (gridMerged.DataSource == null)
        return;

    BindingSource _bs = gridMerged.DataSource as BindingSource;

    if (_bs == null)
        return;

    if (_bs.DataSource == null)
        return;

    // 1) 클릭한 컬럼 확인
    if (col < 0 || col >= gridMerged.Columns.Count)
        return;

    DataGridViewColumn clickedColumn = gridMerged.Columns[col];

    if (clickedColumn == null)
        return;

    string n = clickedColumn.DataPropertyName;

    if (string.IsNullOrEmpty(n))
        n = clickedColumn.Name;

    if (string.IsNullOrEmpty(n))
        return;

    string colKey = n;

    // 2) 동적 컬럼 여부 확인
    // UpdateDynamicColumnsForSearch()에서 Tag = (key, index) 형태로 넣은 컬럼
    (string keyName, int indexNum)? dynamicColTag = null;

    if (clickedColumn.Tag is ValueTuple<string, int> tagTuple)
    {
        dynamicColTag = (tagTuple.Item1, tagTuple.Item2);
    }

    // 3) 동적 컬럼이면 필터 키는 컬럼 Name 기준으로 사용
    if (dynamicColTag != null)
    {
        colKey = clickedColumn.Name;
    }

    // 4) 필터 목록용 Row 확보
    // 현재 컬럼 필터는 제외한 상태로 목록 생성
    // 그래야 엑셀처럼 같은 컬럼에서 여러 값을 추가 선택 가능
    List<CombinedRow> allRows = GetRowsForFilterMenu(colKey);

    if (allRows == null || allRows.Count == 0)
        return;

    // 5) 필터 목록에 표시할 값 추출
    var vals = new List<string>();

    if (dynamicColTag != null)
    {
        var tag = dynamicColTag.Value;
        string keyNameVal = tag.keyName;
        int indexNumVal = tag.indexNum;

        vals = allRows
            .Select(r => GetDynamicValueInRowRange(r, keyNameVal, indexNumVal))
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }
    else
    {
        if (colKey == "StartTs" || colKey == "EndTs" || colKey == "SuccessTs")
        {
            vals = allRows
                .Select(r =>
                {
                    var prop = typeof(CombinedRow).GetProperty(colKey);

                    if (prop == null)
                        return null;

                    var value = prop.GetValue(r);

                    if (value == null)
                        return null;

                    DateTime? dt = GetDateTimeValue(r, colKey);

                    if (!dt.HasValue)
                        return null;

                    return dt.Value.ToString("yyyy-MM-dd HH:mm:ss.fff");
                })
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        else
        {
            vals = allRows
                .Select(r =>
                {
                    var prop = typeof(CombinedRow).GetProperty(colKey);

                    if (prop == null)
                        return null;

                    var value = prop.GetValue(r);

                    return value == null ? "(null)" : Convert.ToString(value);
                })
                .Where(s => s != null)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    // 6) 메뉴 구성
    ContextMenuStrip m = new ContextMenuStrip();

    m.Items.Add("필터 초기화", null, (s, e) =>
    {
        activeFilters.Clear();

        txtSearchVar.Text = _BizS;
        txtSearchVar.ForeColor = Color.Gray;

        searchMergedRows = null;

        ApplyMergedView(true, true);
    });

    m.Items.Add(new ToolStripSeparator());

    // 값이 너무 많으면 상위 20개만 먼저 표시
    var valuesToShow = vals.Take(20).ToList();

    foreach (string v in valuesToShow)
    {
        string filterValue = v;

        ToolStripMenuItem item = new ToolStripMenuItem(filterValue);

        item.Checked =
            activeFilters.ContainsKey(colKey) &&
            activeFilters[colKey].Any(x =>
                string.Equals(x, filterValue, StringComparison.OrdinalIgnoreCase));

        item.Click += (s, e) =>
        {
            if (!activeFilters.ContainsKey(colKey))
                activeFilters[colKey] = new List<string>();

            bool alreadyChecked = activeFilters[colKey].Any(x =>
                string.Equals(x, filterValue, StringComparison.OrdinalIgnoreCase));

            if (alreadyChecked)
            {
                activeFilters[colKey].RemoveAll(x =>
                    string.Equals(x, filterValue, StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                activeFilters[colKey].Add(filterValue);
            }

            // BR명 컬럼 필터일 때만 검색창에 "BR_A || BR_B" 형태로 반영
            SyncMergedVarFilterToSearchBox(colKey);

            bool rebuildDynamicColumns =
                string.Equals(colKey, "Var", StringComparison.OrdinalIgnoreCase);

            ApplyFilters(rebuildDynamicColumns);
        };

        m.Items.Add(item);
    }

    if (vals.Count > 20)
    {
        m.Items.Add(new ToolStripSeparator());

        var searchItem = new ToolStripMenuItem("더보기...");

        searchItem.Click += (s, e) =>
        {
            ShowFilterSearchDialog(colKey, vals);
        };

        m.Items.Add(searchItem);
    }

    m.Show(gridMerged, gridMerged.PointToClient(Cursor.Position));
}



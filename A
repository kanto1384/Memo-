1. 새 메서드 추가

추가 위치

ReadBlock(...) 메서드 근처에 추가.

private string ReadBlockRange(string file, int startIdx, int endIdx)
{
    if (string.IsNullOrWhiteSpace(file))
        return "";

    if (startIdx < 0)
        return "";

    string fp = Path.Combine(txtFolder.Text, file);

    if (!File.Exists(fp))
        return "";

    var sb = new StringBuilder();

    int current = 0;

    using (var fs = new FileStream(
        fp,
        FileMode.Open,
        FileAccess.Read,
        FileShare.ReadWrite | FileShare.Delete))
    using (var sr = new StreamReader(fs, Encoding.UTF8, true, 1024 * 64))
    {
        string line;

        while ((line = sr.ReadLine()) != null)
        {
            if (current < startIdx)
            {
                current++;
                continue;
            }

            if (endIdx >= 0 && current > endIdx)
                break;

            sb.AppendLine(line);
            current++;
        }
    }

    return sb.ToString();
}


